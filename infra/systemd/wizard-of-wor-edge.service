[Unit]
Description=Wizard of Wor - Edge Reverse Proxy (Caddy, public HTTPS)
Documentation=https://github.com/sushiomsky/swow
Requires=docker.service
After=docker.service network-online.target wizard-of-wor-compose.service
Wants=network-online.target
PartOf=wizard-of-wor-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The edge profile only ADDS the Caddy container to the running stack.
# Upstream services are managed by wizard-of-wor-compose.service; the edge
# unit restarts on compose changes via PartOf.
WorkingDirectory=/opt/wizard-of-wor
EnvironmentFile=-/opt/wizard-of-wor/.env.production
ExecStart=/usr/bin/docker compose --profile edge up -d edge
ExecStop=/usr/bin/docker compose --profile edge stop edge
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
